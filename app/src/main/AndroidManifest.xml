<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- 本地视频库：MediaStore.Video 读取权限 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- 传输管理下载目录：原生直写共享存储所需的权限。
         走「所有文件访问权限」（Android 11+）或旧版 WRITE_EXTERNAL_STORAGE（Android 10-），
         替代 SAF，避免 ContentProvider 虚拟层写入的性能损耗。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 17+ 本地网络访问权限（SMB/FTP/WebDAV 等局域网设备） -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- 在线更新：安装未知来源 APK 所需的声明（实际授予由用户在系统设置中操作） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NIplayer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard"
            android:theme="@style/Theme.NIplayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 视频播放器独立 Activity：由 MainActivity 经 startActivity 启动（非 Launcher 入口） -->
        <!-- Android 16+：屏幕宽度 >=600dp 的大屏（平板）默认忽略 Activity 的方向/可调整尺寸/宽高比限制，
             包括 setRequestedOrientation()，导致播放器"自动方向/HUD旋转"被系统无视。
             此处声明 PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY 重新放开方向限制，让播放器恢复横竖屏自控。
             注意：该豁免仅存在于 Android 16 设备，Android 17 已移除，届时需改用画面旋转方案。 -->
        <activity
            android:name="com.nichx.niplayer.feature.player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard"
            android:theme="@style/Theme.NIplayer">
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>

        <service
            android:name="com.nichx.niplayer.feature.player.AudioPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
